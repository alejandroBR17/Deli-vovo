# Desenvolvimento local: copie para .env (ignorado pelo Git).
# Crie data/ antes de executar npm run db:migrate.
# Não reutilize o banco ou as credenciais de produção.
NODE_ENV=development
PORT=3000
TURSO_DATABASE_URL=file:./data/delivery.db
TURSO_AUTH_TOKEN=
# Aliases aceitos pela integração Turso/Vercel; vazios no ambiente local.
STORAGE_TURSO_DATABASE_URL=
STORAGE_TURSO_AUTH_TOKEN=

# Defina uma senha própria e um segredo aleatório de pelo menos 32 caracteres.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Mercado Pago: credenciais de teste somente no servidor. Nunca prefixar com VITE_.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_SELLER_ID=
MERCADO_PAGO_MODE=test
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_RETURN_ORIGIN=
MERCADO_PAGO_CHECKOUT_ENABLED=false

# Avisos administrativos. Gere uma vez com node generate-vapid.js.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com

# Recuperação de senha (opcional em desenvolvimento). TLS: porta 465 ou 587.
# Gmail usa senha de aplicativo; nunca a senha normal da conta.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Origem HTTPS sem caminho/query/fragmento; não confie no Host da requisição.
AUTH_PUBLIC_URL=

# Somente prévia LOCAL de teste; ignorado em deployments Vercel.
DELIVERY_PREVIEW_MODE=false

# Integrações legadas — deixe vazias. Produção atual usa Turso/Mercado Pago.
GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_API_SECRET=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Somente para exportação manual de uma origem antiga; não usados pelo app.
LEGACY_FIREBASE_SERVICE_ACCOUNT_FILE=
LEGACY_FIREBASE_PROJECT_ID=
LEGACY_FIREBASE_DATABASE_ID=
