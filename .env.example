# Variáveis de Ambiente para Vercel
# Copie e cole estas variáveis no painel da Vercel (Settings > Environment Variables)

# 1. URL do Google Apps Script (Google Sheets)
# IMPORTANTE: Esta é a URL gerada após implantar o script como "Aplicativo da Web" no menu do Planilhas Google.
# Exemplo: https://script.google.com/macros/s/AKfycbzxxxxxxxxx/exec
GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_API_SECRET=

# 2. Stripe (Pagamentos)
# ATENÇÃO: Use a chave que começa com "sk_test_..." (Secret Key)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Mercado Pago Checkout Pro (Preferences API): somente servidor, nunca VITE_.
# Teste e produção usam vendedores distintos; confira users/me antes de configurar.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_SELLER_ID=
MERCADO_PAGO_MODE=test
MERCADO_PAGO_WEBHOOK_SECRET=
# Obrigatório em produção: mesmo domínio no qual o cliente inicia a compra.
MERCADO_PAGO_RETURN_ORIGIN=
# Habilitar somente depois de configurar e validar o webhook.
MERCADO_PAGO_CHECKOUT_ENABLED=false

# 3. Chaves VAPID fixas. Gere uma vez com node generate-vapid.js e guarde fora do Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ale.sobral.cortes@gmail.com

# 4. Turso: banco exclusivo do delivery; estas variáveis são privadas.
# Nos testes locais, use TURSO_DATABASE_URL=file:./data/delivery.db e deixe o token vazio.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# A integração Vercel com prefixo STORAGE também é aceita diretamente.
STORAGE_TURSO_DATABASE_URL=
STORAGE_TURSO_AUTH_TOKEN=

# 5. Acesso ao painel. Segredo de sessão com pelo menos 32 caracteres aleatórios.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 6. Outras
NODE_ENV=production
# Somente prévia local: abre a loja fora do horário e exibe aviso de teste.
# Ignorado na Vercel. Não habilite no serviço real da loja.
DELIVERY_PREVIEW_MODE=false
