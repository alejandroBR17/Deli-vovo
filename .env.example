# Variáveis de Ambiente para Vercel
# Copie e cole estas variáveis no painel da Vercel (Settings > Environment Variables)

# 1. URL do Google Apps Script (Google Sheets)
# IMPORTANTE: Esta é a URL gerada após implantar o script como "Aplicativo da Web" no menu do Planilhas Google.
# Exemplo: https://script.google.com/macros/s/AKfycbzxxxxxxxxx/exec
GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_API_SECRET=

# 2. Stripe (Pagamentos)
# ATENÇÃO: Use a chave que começa com "sk_test_..." (Secret Key)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# 3. Chaves VAPID fixas. Gere uma vez com node generate-vapid.js e guarde fora do Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ale.sobral.cortes@gmail.com

# 4. Acesso privado ao banco para o servidor (não usar prefixo VITE_).
# JSON da conta de serviço com acesso ao mesmo banco existente.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_ID=

# 5. Acesso ao painel. Segredo de sessão com pelo menos 32 caracteres aleatórios.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 6. Outras
NODE_ENV=production
